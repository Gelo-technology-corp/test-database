<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!--                       SUPPLIERS                              -->
        <!-- ============================================================ -->

        <!-- CDO FoodSphere Inc. - Main Supplier -->
        <record id="partner_cdo_foodsphere" model="res.partner">
            <field name="name">CDO FoodSphere Inc.</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="street">CDO Building, Araneta Center</field>
            <field name="city">Quezon City</field>
            <field name="country_id" ref="base.ph"/>
            <field name="phone">+63 2 8911 1111</field>
            <field name="website">https://www.cdofoodsphere.com</field>
            <field name="supplier_rank" eval="1"/>
            <field name="customer_rank" eval="0"/>
        </record>

        <!-- ============================================================ -->
        <!--                       CUSTOMERS                              -->
        <!-- ============================================================ -->

        <!-- Alphamart -->
        <record id="partner_alphamart" model="res.partner">
            <field name="name">Alphamart</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="city">Metro Manila</field>
            <field name="country_id" ref="base.ph"/>
            <field name="supplier_rank" eval="0"/>
            <field name="customer_rank" eval="1"/>
        </record>

        <!-- Asari Asari Store -->
        <record id="partner_asari_asari_store" model="res.partner">
            <field name="name">Asari Asari Store</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="city">Metro Manila</field>
            <field name="country_id" ref="base.ph"/>
            <field name="supplier_rank" eval="0"/>
            <field name="customer_rank" eval="1"/>
        </record>

        <!-- Easy Mart -->
        <record id="partner_easy_mart" model="res.partner">
            <field name="name">Easy Mart</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="city">Metro Manila</field>
            <field name="country_id" ref="base.ph"/>
            <field name="supplier_rank" eval="0"/>
            <field name="customer_rank" eval="1"/>
        </record>

        <!-- Tambayan Store -->
        <record id="partner_tambayan_store" model="res.partner">
            <field name="name">Tambayan Store</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="city">Metro Manila</field>
            <field name="country_id" ref="base.ph"/>
            <field name="supplier_rank" eval="0"/>
            <field name="customer_rank" eval="1"/>
        </record>

        <!-- ============================================================ -->
        <!--             KEY CONTACTS (People at JRL/Daya)                -->
        <!-- ============================================================ -->

        <!-- Maria Lea Endaya - Management / JRL Daya -->
        <record id="partner_maria_lea_endaya" model="res.partner">
            <field name="name">Maria Lea Endaya</field>
            <field name="is_company" eval="False"/>
            <field name="company_type">person</field>
            <field name="function">Management</field>
            <field name="country_id" ref="base.ph"/>
        </record>

    </data>
</odoo>
